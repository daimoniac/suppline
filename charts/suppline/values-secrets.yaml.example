# Secret values — DO NOT COMMIT
#
#   cp charts/suppline/values-secrets.yaml.example charts/suppline/values-secrets.yaml
#
# Production default is bring-your-own registry (registry.enabled=false).
# Set SUPPLINE_REGISTRY_* to your Harbor/ECR/ACR/Artifactory endpoint.

backend:
  secrets:
    SUPPLINE_API_KEY: "your-api-key-here"

    # Cosign attestation key (base64-encoded private key)
    #   cosign generate-key-pair
    #   ATTESTATION_KEY=$(base64 -w0 cosign.key)
    ATTESTATION_KEY: "LS0tLS1CRUdJTi4uLg=="
    ATTESTATION_KEY_PASSWORD: "your-cosign-password"

    # Upstream pull credentials (as needed by your suppline.yml creds)
    DOCKER_USERNAME: "your-docker-username"
    DOCKER_PASSWORD: "your-docker-password-or-token"

    # Bring-your-own target registry (required when registry.enabled=false)
    SUPPLINE_REGISTRY_URL: "harbor.example.com/suppline"
    SUPPLINE_REGISTRY_USERNAME: "suppline"
    SUPPLINE_REGISTRY_PASSWORD: "your-registry-password"

# Optional: enable the chart’s bundled registry:3 for labs only
# registry:
#   enabled: true
